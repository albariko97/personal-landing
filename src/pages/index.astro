---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutBento from '../components/AboutBento.astro';
import AiProjects from '../components/AiProjects.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import MusicSection from '../components/MusicSection.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`${siteConfig.name} — Full Stack & Platform Engineer`}
  description={siteConfig.headline}
>
  <Navbar />
  <main class="flex-1">
    <Hero />
    <AboutBento />
    <AiProjects />
    <ToolsGrid />
    <MusicSection />
  </main>
  <Footer />
</BaseLayout>
