---
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import MusicCard from './MusicCard.astro';

const tracks = (await getCollection('music')).sort(
  (a, b) => new Date(b.data.releaseDate).getTime() - new Date(a.data.releaseDate).getTime()
);
---

<section id="music" class="py-20 md:py-28 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index="03 // MUSIC & PRODUCTION"
      title="Sound Engineering, Composition & Releases"
      description="Applying acoustic principles, gain staging, and analog-modeled mix techniques to original recorded tracks."
    />

    <div class="space-y-6">
      {tracks.map((track) => (
        <MusicCard track={track} />
      ))}
    </div>
  </div>
</section>
