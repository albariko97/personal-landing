---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';
import MusicCard from './MusicCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const tracks = (await getCollection('music', (entry) => entry.data.lang === lang)).sort(
  (a, b) => new Date(b.data.releaseDate).getTime() - new Date(a.data.releaseDate).getTime()
);
---

<section id="music" class="py-20 md:py-28 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index={t('music.index')}
      title={t('music.title')}
      description={t('music.desc')}
    />

    <div class="space-y-6">
      {tracks.map((track) => (
        <MusicCard track={track} />
      ))}
    </div>
  </div>
</section>
