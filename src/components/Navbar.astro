---
import { siteConfig } from '../config/site';

const navItems = siteConfig.navLinks;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#09090B]/85 border-b border-white/[0.06] transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Monogram -->
    <a
      href="#top"
      class="group flex items-center gap-1.5 font-mono text-sm font-bold tracking-tight text-zinc-100 hover:text-white transition-colors"
      aria-label="Home"
    >
      <span class="text-zinc-100 group-hover:text-white">{siteConfig.initials}</span>
      <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 text-xs font-mono font-medium text-zinc-400 hover:text-zinc-100 hover:bg-white/[0.04] rounded-md transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right Action / Contact CTA -->
    <div class="flex items-center gap-3">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-mono font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-500 transition-colors shadow-sm shadow-blue-500/20 active:scale-95"
      >
        <span>Get in touch</span>
        <span class="text-blue-200">→</span>
      </a>
    </div>
  </div>

  <!-- Mobile Secondary Sub-bar for seamless anchor jumps -->
  <div class="md:hidden flex items-center justify-start gap-4 px-4 py-2 border-t border-white/[0.04] overflow-x-auto scrollbar-none text-xs font-mono text-zinc-400">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="whitespace-nowrap hover:text-zinc-100 py-0.5 transition-colors"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>
