---
import { siteConfig } from '../config/site';
import SectionHeader from './SectionHeader.astro';

const pillars = siteConfig.bentoPillars;
---

<section id="about" class="py-20 md:py-28 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index="00 // ABOUT & EXPERTISE"
      title="Systems Engineering at Enterprise Scale & Creative Intersections"
      description="Engineering resilient digital platforms, distributed microservices, and specialized AI developer tools."
    />

    <!-- Narrative Bio -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-14 items-start">
      <div class="lg:col-span-8 space-y-4 text-base sm:text-lg text-zinc-300 leading-relaxed font-normal">
        {siteConfig.bio.map((paragraph) => (
          <p class="text-zinc-300">
            {paragraph}
          </p>
        ))}
      </div>

      <!-- Quick Metrics / Summary Box -->
      <div class="lg:col-span-4 p-6 rounded-xl bg-[#111114] border border-white/[0.08] space-y-4">
        <h4 class="font-mono text-xs uppercase tracking-wider text-zinc-400 font-semibold border-b border-white/[0.06] pb-2">
          Fast Facts
        </h4>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="font-mono text-xs text-zinc-500">Education</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">Systems & Computer Eng. + Industrial Eng.</dd>
            <dd class="text-zinc-400 text-xs mt-0.5">Universidad de los Andes</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-zinc-500">Minor</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">Music Recording Techniques</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-zinc-500">Experience</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">6+ Years in Enterprise Platforms & Full Stack</dd>
            <dd class="text-zinc-400 text-xs mt-0.5">Amadeus Platform Specialist Alumni</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-zinc-500">Focus Areas</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">Cloud Edge, Terraform, K8s, Observability, MCP</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- 3-Column Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pillars.map((pillar, idx) => (
        <div class="group flex flex-col justify-between p-6 sm:p-7 rounded-xl bg-[#111114] border border-white/[0.08] hover:border-white/20 hover:bg-[#141418] transition-all duration-200">
          <div>
            <!-- Index Pill -->
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs text-blue-400 font-medium">
                Pillar 0{idx + 1}
              </span>
            </div>

            <h3 class="text-lg font-semibold tracking-tight text-zinc-100 group-hover:text-blue-400 transition-colors">
              {pillar.title}
            </h3>
            <p class="font-mono text-xs text-zinc-500 mt-1 mb-3">
              {pillar.subtitle}
            </p>
            <p class="text-sm text-zinc-400 leading-relaxed">
              {pillar.description}
            </p>
          </div>

          <!-- Skills Pills -->
          <div class="mt-6 pt-4 border-t border-white/[0.05]">
            <div class="flex flex-wrap gap-1.5">
              {pillar.skills.map((skill) => (
                <span class="font-mono text-[11px] text-zinc-300 bg-white/[0.04] border border-white/[0.06] px-2 py-0.5 rounded">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
