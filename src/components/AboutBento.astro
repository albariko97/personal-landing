---
import { siteConfig } from '../config/site';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pillars = [
  {
    title: t('pillar1.title'),
    sub: t('pillar1.sub'),
    desc: t('pillar1.desc'),
    skills: siteConfig.coreTech[0].skills,
  },
  {
    title: t('pillar2.title'),
    sub: t('pillar2.sub'),
    desc: t('pillar2.desc'),
    skills: siteConfig.coreTech[1].skills,
  },
  {
    title: t('pillar3.title'),
    sub: t('pillar3.sub'),
    desc: t('pillar3.desc'),
    skills: siteConfig.coreTech[2].skills,
  },
];
---

<section id="about" class="py-20 md:py-28 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index={t('about.index')}
      title={t('about.title')}
      description={t('about.description')}
    />

    <!-- Narrative Bio -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-14 items-start">
      <div class="lg:col-span-8 space-y-4 text-base sm:text-lg text-zinc-300 leading-relaxed font-normal">
        <p class="text-zinc-300">
          {t('about.bio1')}
        </p>
        <p class="text-zinc-300">
          {t('about.bio2')}
        </p>
        <p class="text-zinc-300">
          {t('about.bio3')}
        </p>
      </div>

      <!-- Quick Metrics / Credentials Box -->
      <div class="lg:col-span-4 p-6 rounded-xl bg-[#131823] border border-white/[0.08] space-y-4">
        <h4 class="font-mono text-xs uppercase tracking-wider text-zinc-400 font-semibold border-b border-white/[0.06] pb-2">
          {t('facts.title')}
        </h4>
        <dl class="space-y-3.5 text-sm">
          <div>
            <dt class="font-mono text-xs text-zinc-500">{t('facts.eduLabel')}</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">{t('facts.eduVal')}</dd>
            <dd class="text-zinc-400 text-xs mt-0.5">{t('facts.eduSub')}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-zinc-500">{t('facts.minorLabel')}</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">{t('facts.minorVal')}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-sky-400 flex items-center gap-1">
              <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
              </svg>
              {t('facts.divingLabel')}
            </dt>
            <dd class="text-zinc-200 font-medium mt-0.5">{t('facts.divingVal')}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-zinc-500">{t('facts.expLabel')}</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">{t('facts.expVal')}</dd>
            <dd class="text-zinc-400 text-xs mt-0.5">{t('facts.expSub')}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs text-zinc-500">{t('facts.focusLabel')}</dt>
            <dd class="text-zinc-200 font-medium mt-0.5">{t('facts.focusVal')}</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- 3-Column Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pillars.map((pillar, idx) => (
        <div class="group flex flex-col justify-between p-6 sm:p-7 rounded-xl bg-[#131823] border border-white/[0.08] hover:border-white/20 hover:bg-[#182030] transition-all duration-200">
          <div>
            <!-- Index Pill -->
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs text-blue-400 font-medium">
                Pillar 0{idx + 1}
              </span>
            </div>

            <h3 class="text-lg font-semibold tracking-tight text-zinc-100 group-hover:text-blue-400 transition-colors">
              {pillar.title}
            </h3>
            <p class="font-mono text-xs text-zinc-500 mt-1 mb-3">
              {pillar.sub}
            </p>
            <p class="text-sm text-zinc-400 leading-relaxed">
              {pillar.desc}
            </p>
          </div>

          <!-- Skills Pills -->
          <div class="mt-6 pt-4 border-t border-white/[0.05]">
            <div class="flex flex-wrap gap-1.5">
              {pillar.skills.map((skill) => (
                <span class="font-mono text-[11px] text-zinc-300 bg-white/[0.04] border border-white/[0.06] px-2 py-0.5 rounded">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
