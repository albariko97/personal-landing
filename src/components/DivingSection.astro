---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';
import DiveCard from './DiveCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const dives = (await getCollection('diving', (entry) => entry.data.lang === lang)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<section id="diving" class="py-20 md:py-28 border-b border-white/[0.06] relative">
  <!-- Subtle ambient oceanic backdrop glow -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-96 h-96 bg-sky-500/[0.03] rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionHeader
      index={t('diving.index')}
      title={t('diving.title')}
      description={t('diving.desc')}
    />

    <!-- Verified PADI Diving Metrics Banner -->
    <div class="mb-10 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      <div class="p-4 sm:p-5 rounded-xl bg-[#0F1726]/80 border border-sky-500/20 text-center">
        <span class="block text-2xl sm:text-3xl font-bold font-mono text-sky-400">12</span>
        <span class="block text-xs font-mono text-zinc-400 mt-1 uppercase tracking-wider">{t('diving.statDives')}</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl bg-[#0F1726]/80 border border-sky-500/20 text-center">
        <span class="block text-2xl sm:text-3xl font-bold font-mono text-sky-400">528 <span class="text-sm font-normal text-sky-300/70">min</span></span>
        <span class="block text-xs font-mono text-zinc-400 mt-1 uppercase tracking-wider">{t('diving.statBottomTime')}</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl bg-[#0F1726]/80 border border-sky-500/20 text-center">
        <span class="block text-2xl sm:text-3xl font-bold font-mono text-sky-400">4</span>
        <span class="block text-xs font-mono text-zinc-400 mt-1 uppercase tracking-wider">{t('diving.statRegions')}</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl bg-[#0F1726]/80 border border-sky-500/20 text-center">
        <span class="block text-sm sm:text-base font-bold font-mono text-sky-300 mt-1">Flynn Reef, AU</span>
        <span class="block text-xs font-mono text-zinc-400 mt-1 uppercase tracking-wider">{t('diving.statCertSite')}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {dives.map((dive) => (
        <DiveCard dive={dive} />
      ))}
    </div>
  </div>
</section>
