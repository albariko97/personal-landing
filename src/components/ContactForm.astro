---
import { siteConfig } from '../config/site';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);
---

<div class={`p-6 sm:p-8 rounded-2xl bg-[#0F1420] border border-white/10 shadow-xl ${className}`}>
  <div class="mb-6">
    <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-zinc-100 flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m22 2-7 20-4-9-9-4Z"></path>
        <path d="M22 2 11 13"></path>
      </svg>
      {t('form.title')}
    </h3>
  </div>

  <!-- Form Success Container (Hidden initially) -->
  <div id="contact-form-success" class="hidden p-6 rounded-xl bg-blue-500/10 border border-blue-500/30 text-center">
    <div class="w-12 h-12 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center mx-auto mb-3">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h4 class="text-base font-semibold text-zinc-100 mb-1">{t('form.successTitle')}</h4>
    <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed max-w-sm mx-auto mb-4">
      {t('form.successDesc')}
    </p>
    <button
      type="button"
      id="contact-form-reset"
      class="px-4 py-2 text-xs font-mono font-medium rounded-lg bg-[#182030] text-zinc-300 hover:text-white border border-white/10 hover:border-white/20 transition-all cursor-pointer"
    >
      {t('form.sendAnother')}
    </button>
  </div>

  <!-- Form Error Alert (Hidden initially) -->
  <div id="contact-form-error" class="hidden mb-4 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-200">
    <div class="flex items-center gap-2 font-semibold mb-1">
      <svg class="w-4 h-4 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      {t('form.errorTitle')}
    </div>
    <p>
      {t('form.errorDesc')} <a href={`mailto:${siteConfig.email}`} class="underline hover:text-white">{siteConfig.email}</a>.
    </p>
  </div>

  <!-- The Actual Form -->
  <form id="contact-form" class="space-y-4">
    <!-- Web3Forms API Hidden Parameters -->
    <input type="hidden" name="access_key" value={siteConfig.contactForm.accessKey} />
    <input type="hidden" name="from_name" value={`Portfolio Contact Form (${lang.toUpperCase()})`} />
    <input type="hidden" name="subject" value="New Direct Message from Álvaro's Personal Website" />
    <!-- Spam Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    <!-- Name & Email Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="contact-name" class="block font-mono text-xs font-medium text-zinc-300 mb-1.5">
          {t('form.nameLabel')} <span class="text-blue-400">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          placeholder={t('form.namePlaceholder')}
          class="w-full px-3.5 py-2.5 text-xs sm:text-sm font-sans rounded-lg bg-[#161B28] text-zinc-100 placeholder:text-zinc-600 border border-white/10 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-all"
        />
      </div>

      <div>
        <label for="contact-email" class="block font-mono text-xs font-medium text-zinc-300 mb-1.5">
          {t('form.emailLabel')} <span class="text-blue-400">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          placeholder={t('form.emailPlaceholder')}
          class="w-full px-3.5 py-2.5 text-xs sm:text-sm font-sans rounded-lg bg-[#161B28] text-zinc-100 placeholder:text-zinc-600 border border-white/10 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-all"
        />
      </div>
    </div>

    <!-- Topic / Subject Dropdown -->
    <div>
      <label for="contact-topic" class="block font-mono text-xs font-medium text-zinc-300 mb-1.5">
        {t('form.topicLabel')}
      </label>
      <select
        id="contact-topic"
        name="topic"
        class="w-full px-3.5 py-2.5 text-xs sm:text-sm font-sans rounded-lg bg-[#161B28] text-zinc-200 border border-white/10 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-all"
      >
        <option value="" disabled selected>{t('form.topicDefault')}</option>
        <option value="Platform Architecture & Cloud">{t('form.topicPlatform')}</option>
        <option value="AI Agents & Developer Tools">{t('form.topicAi')}</option>
        <option value="Music Production & Recording">{t('form.topicMusic')}</option>
        <option value="Scuba Diving Expeditions">{t('form.topicDiving')}</option>
        <option value="General Inquiry">{t('form.topicGeneral')}</option>
      </select>
    </div>

    <!-- Message Area -->
    <div>
      <label for="contact-message" class="block font-mono text-xs font-medium text-zinc-300 mb-1.5">
        {t('form.messageLabel')} <span class="text-blue-400">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        placeholder={t('form.messagePlaceholder')}
        class="w-full px-3.5 py-2.5 text-xs sm:text-sm font-sans rounded-lg bg-[#161B28] text-zinc-100 placeholder:text-zinc-600 border border-white/10 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-all resize-y min-h-[90px]"
      ></textarea>
    </div>

    <!-- Submit Button -->
    <div>
      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 text-xs sm:text-sm font-mono font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-500 transition-all shadow-md shadow-blue-500/20 active:scale-[0.98] cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg id="contact-btn-icon" class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
        <svg id="contact-btn-spinner" class="w-4 h-4 animate-spin hidden" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span id="contact-btn-text">{t('form.submit')}</span>
      </button>
    </div>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('contact-btn-text');
    const btnIcon = document.getElementById('contact-btn-icon');
    const btnSpinner = document.getElementById('contact-btn-spinner');
    const successBox = document.getElementById('contact-form-success');
    const errorBox = document.getElementById('contact-form-error');
    const resetBtn = document.getElementById('contact-form-reset');

    if (!form || !submitBtn || !btnText) return;

    const originalBtnText = btnText.textContent || 'Send Message';
    const submittingText = document.documentElement.lang === 'es' ? 'Enviando mensaje...' : 'Sending message...';

    form.onsubmit = async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Hide previous errors
      if (errorBox) errorBox.classList.add('hidden');

      // Set Submitting State
      submitBtn.disabled = true;
      btnText.textContent = submittingText;
      if (btnIcon) btnIcon.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          form.classList.add('hidden');
          if (successBox) successBox.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (err) {
        console.error('Contact form error:', err);
        if (errorBox) errorBox.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = originalBtnText;
        if (btnIcon) btnIcon.classList.remove('hidden');
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    };

    if (resetBtn) {
      resetBtn.onclick = () => {
        if (successBox) successBox.classList.add('hidden');
        if (form) form.classList.remove('hidden');
      };
    }
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
