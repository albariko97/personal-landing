---
import type { CollectionEntry } from 'astro:content';

interface Props {
  dive: CollectionEntry<'diving'>;
}

const { dive } = Astro.props;
const {
  title,
  location,
  certification,
  date,
  maxDepth,
  visibility,
  waterTemp,
  highlights,
  description,
  diveNumbers,
} = dive.data;
---

<article class="group relative flex flex-col justify-between p-6 sm:p-8 rounded-xl bg-gradient-to-b from-[#131823] to-[#0F1726] border border-sky-500/20 hover:border-sky-500/40 hover:from-[#162030] hover:to-[#121D30] transition-all duration-200">
  <div>
    <!-- Top Metadata: Cert Badge, Dive Numbers + Date -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-mono font-medium rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/25">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
          </svg>
          {certification}
        </span>

        {diveNumbers && (
          <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-mono font-medium rounded bg-sky-500/[0.08] text-sky-300 border border-sky-500/20">
            {diveNumbers}
          </span>
        )}
      </div>

      <span class="font-mono text-xs text-zinc-500">
        {date}
      </span>
    </div>

    <!-- Location line -->
    <div class="mb-2">
      <span class="inline-flex items-center gap-1 text-xs font-mono text-zinc-400">
        <svg class="w-3.5 h-3.5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {location}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-100 group-hover:text-sky-300 transition-colors">
      {title}
    </h3>

    <!-- Dive Metrics Bar -->
    <div class="mt-4 flex flex-wrap items-center gap-2.5 p-3 rounded-lg bg-[#0D131F]/90 border border-sky-500/15 font-mono text-xs text-zinc-300">
      <div class="flex items-center gap-1.5 text-sky-400 font-semibold">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v20M17 17l-5 5-5-5"></path>
        </svg>
        <span>Max Depth: {maxDepth}</span>
      </div>

      {visibility && (
        <>
          <span class="text-zinc-600">•</span>
          <span class="text-zinc-400">Vis: {visibility}</span>
        </>
      )}

      {waterTemp && (
        <>
          <span class="text-zinc-600">•</span>
          <span class="text-zinc-400">Temp: {waterTemp}</span>
        </>
      )}
    </div>

    <!-- Field Notes / Narrative -->
    <p class="mt-4 text-sm sm:text-base text-zinc-300/90 leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-sky-500/10">
    <!-- Highlights / Marine Tags -->
    <div class="flex flex-wrap gap-1.5">
      {highlights.map((tag) => (
        <span class="font-mono text-[11px] text-sky-300/80 bg-sky-500/[0.07] border border-sky-500/20 px-2.5 py-0.5 rounded">
          {tag}
        </span>
      ))}
    </div>
  </div>
</article>
