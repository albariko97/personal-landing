---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="events" class="py-20 md:py-28 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index={t('events.index')}
      title={t('events.title')}
      description={t('events.desc')}
    />

    <!-- Editorial Teaser Card -->
    <div class="p-8 sm:p-10 rounded-2xl bg-[#131823] border border-white/[0.08] relative overflow-hidden">
      <!-- Subtle highlight border accent -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 mb-4">
            <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
            <span class="font-mono text-xs font-semibold text-blue-400 tracking-wider">
              {t('events.teaserBadge')}
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-100">
            {t('events.teaserTitle')}
          </h3>

          <p class="mt-3 text-sm sm:text-base text-zinc-400 leading-relaxed">
            {t('events.teaserDesc')}
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-5 py-3 text-xs sm:text-sm font-mono font-medium rounded-lg bg-[#182030] text-zinc-200 border border-white/10 hover:border-blue-500/40 hover:text-white hover:bg-blue-500/10 transition-all active:scale-95"
          >
            <span>{t('events.teaserCta')}</span>
            <span class="text-blue-400">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
