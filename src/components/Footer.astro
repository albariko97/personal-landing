---
import { siteConfig } from '../config/site';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import CopyEmailButton from './CopyEmailButton.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="py-20 md:py-24 bg-[#0B0F17]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-8 sm:p-12 rounded-2xl bg-[#131823] border border-white/[0.08] relative overflow-hidden">
      <!-- Background subtle glow decoration -->
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="font-mono text-xs font-semibold text-blue-400 uppercase tracking-wider bg-blue-500/10 border border-blue-500/20 px-2.5 py-0.5 rounded">
            {t('contact.index')}
          </span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-zinc-100">
          {t('contact.title')}
        </h2>

        <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
          {t('contact.desc')}
        </p>

        <!-- Action Buttons -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-mono font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-500 transition-colors shadow-lg shadow-blue-500/25 active:scale-95"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{t('contact.sendMsg')}</span>
          </a>

          <CopyEmailButton showAddress={true} class="py-2.5 px-4 text-xs sm:text-sm" />
        </div>

        <!-- Social Channels -->
        <div class="mt-10 pt-8 border-t border-white/[0.06] flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-400">
            <a
              href={siteConfig.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-zinc-100 transition-colors"
            >
              LinkedIn ↗
            </a>
            <span class="text-zinc-700">•</span>
            <a
              href={siteConfig.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-zinc-100 transition-colors"
            >
              GitHub ↗
            </a>
            <span class="text-zinc-700">•</span>
            {siteConfig.socials.spotify && (
              <a
                href={siteConfig.socials.spotify}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-zinc-100 transition-colors"
              >
                Spotify ↗
              </a>
            )}
            <span class="text-zinc-700">•</span>
            {siteConfig.socials.soundcloud && (
              <a
                href={siteConfig.socials.soundcloud}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-zinc-100 transition-colors"
              >
                SoundCloud ↗
              </a>
            )}
          </div>

          <p class="font-mono text-xs text-zinc-500">
            © {currentYear} {siteConfig.name}. {t('contact.rights')}
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
