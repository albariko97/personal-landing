---
import { siteConfig } from '../config/site';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import CopyEmailButton from './CopyEmailButton.astro';
import ProfileAvatar from './ProfileAvatar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const corePills = [
  'Angular',
  '.NET Core',
  'Java Spring Boot',
  'Node.js',
  'Azure',
  'Kubernetes',
  'Terraform',
  'OpenTelemetry',
];
---

<section id="top" class="relative pt-12 pb-16 md:pt-20 md:pb-24 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col-reverse lg:flex-row lg:items-start lg:justify-between gap-8 lg:gap-12">
      <!-- Left Narrative Column -->
      <div class="max-w-3xl flex-1">
        <!-- Availability / Status Ticker -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-white/[0.03] border border-white/[0.08] mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
          <span class="font-mono text-xs text-zinc-300 font-medium tracking-wide">
            {t('hero.ticker')}
          </span>
        </div>

        <!-- Identity Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-100 leading-[1.15]">
          {t('hero.headline')}
        </h1>

        <!-- Subheadline -->
        <p class="mt-5 text-base sm:text-lg text-zinc-400 leading-relaxed font-normal max-w-2xl">
          {t('hero.subheadline')}
        </p>

        <!-- Core Tech Stack Pills -->
        <div class="mt-7 flex flex-wrap items-center gap-2">
          <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider mr-1">
            {t('hero.stackLabel')}
          </span>
          {corePills.map((tech) => (
            <span class="font-mono text-xs px-2.5 py-1 rounded bg-[#131823] text-zinc-300 border border-white/[0.08] hover:border-white/20 transition-colors">
              {tech}
            </span>
          ))}
        </div>

        <!-- Hero Actions / CTAs -->
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <!-- Direct Mailto Action -->
          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-mono font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-500 transition-colors shadow-lg shadow-blue-500/20 active:scale-95"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{t('hero.ctaContact')}</span>
          </a>

          <!-- One-Click Copy Email Micro-interaction -->
          <CopyEmailButton showAddress={true} class="py-2.5 px-4 text-xs sm:text-sm" />

          <!-- Social Icons -->
          <div class="flex items-center gap-2 pl-1 sm:pl-2">
            <!-- GitHub -->
            <a
              href={siteConfig.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-lg bg-[#131823] text-zinc-400 hover:text-white border border-white/10 hover:border-white/20 transition-all"
              aria-label="GitHub Profile"
              title="GitHub"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              href={siteConfig.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-lg bg-[#131823] text-zinc-400 hover:text-white border border-white/10 hover:border-white/20 transition-all"
              aria-label="LinkedIn Profile"
              title="LinkedIn"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Profile Avatar / Portrait Frame -->
      <div class="shrink-0 flex items-center lg:items-start pt-2">
        <ProfileAvatar />
      </div>
    </div>
  </div>
</section>
