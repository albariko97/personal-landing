---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'ai'>;
  lang?: Lang;
}

const { project, lang = 'en' } = Astro.props;
const { title, description, tags, status, repoUrl, demoUrl, articleUrl } = project.data;
const t = useTranslations(lang);

const statusStyles = {
  Production: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/25',
  Research: 'text-blue-400 bg-blue-500/10 border-blue-500/25',
  Prototype: 'text-amber-400 bg-amber-500/10 border-amber-500/25',
};
---

<article class="group relative flex flex-col justify-between p-6 rounded-xl bg-[#131823] border border-white/[0.08] hover:border-white/20 hover:bg-[#182030] transition-all duration-200">
  <div>
    <!-- Top Metadata: Status & Year -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-mono font-medium rounded-full border ${statusStyles[status]}`}>
        <span class="w-1.5 h-1.5 rounded-full bg-current opacity-80"></span>
        {status}
      </span>
      <span class="font-mono text-xs text-zinc-500">
        {project.data.date.split('-')[0]}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-zinc-100 group-hover:text-blue-400 transition-colors">
      {title}
    </h3>

    <!-- Description -->
    <p class="mt-2.5 text-sm text-zinc-400 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-white/[0.05]">
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tags.map((tag) => (
        <span class="font-mono text-[11px] text-zinc-400 bg-white/[0.03] border border-white/[0.06] px-2 py-0.5 rounded">
          {tag}
        </span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex flex-wrap items-center gap-3 pt-1">
      {repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-zinc-300 hover:text-white transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          {t('card.source')}
          <span class="text-zinc-500 group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      )}
      {articleUrl && (
        <a
          href={articleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-amber-300/90 hover:text-amber-200 transition-colors bg-amber-500/10 border border-amber-500/20 px-2.5 py-1 rounded-md"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
          </svg>
          {t('card.article')}
          <span>↗</span>
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-blue-400 hover:text-blue-300 transition-colors ml-auto"
        >
          {t('card.explore')}
          <span class="group-hover:translate-x-0.5 transition-transform">↗</span>
        </a>
      )}
    </div>
  </div>
</article>
