---
import type { CollectionEntry } from 'astro:content';

interface Props {
  track: CollectionEntry<'music'>;
}

const { track } = Astro.props;
const { title, subtitle, role, description, links, releaseDate } = track.data;
---

<article class="p-6 md:p-8 rounded-xl bg-[#111114] border border-white/[0.08] hover:border-white/20 hover:bg-[#141418] transition-all duration-200">
  <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-4">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-mono font-medium rounded bg-blue-500/10 text-blue-400 border border-blue-500/20">
          {role}
        </span>
        <span class="font-mono text-xs text-zinc-500">
          {releaseDate}
        </span>
      </div>
      <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-100">
        {title}
      </h3>
      <p class="text-sm font-mono text-zinc-400 mt-1">
        {subtitle}
      </p>
    </div>

    <!-- Platform Action Buttons -->
    <div class="flex flex-wrap items-center gap-2 pt-2 md:pt-0">
      {links.spotify && (
        <a
          href={links.spotify}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-medium rounded-lg bg-[#18181D] border border-white/10 text-zinc-200 hover:text-[#1DB954] hover:border-[#1DB954]/40 hover:bg-[#1DB954]/10 transition-colors"
        >
          <!-- Spotify SVG -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.502 17.31c-.215.352-.676.463-1.028.248-2.816-1.72-6.36-2.109-10.536-1.155-.401.092-.801-.158-.893-.56-.092-.402.158-.802.56-.894 4.571-1.045 8.492-.598 11.649 1.333.352.215.463.676.248 1.028zm1.47-3.264c-.27.44-.847.579-1.287.309-3.224-1.982-8.139-2.555-11.953-1.397-.497.151-1.026-.134-1.177-.63-.151-.497.134-1.027.63-1.178 4.364-1.324 9.784-.682 13.478 1.589.44.27.579.847.309 1.287zm.126-3.41c-3.864-2.295-10.245-2.508-13.93-1.389-.592.179-1.222-.16-1.402-.753-.18-.592.16-1.222.753-1.402 4.237-1.286 11.284-1.037 15.717 1.594.534.316.71 1.007.394 1.54-.316.534-1.007.71-1.54.394z"/>
          </svg>
          Spotify
        </a>
      )}

      {links.soundcloud && (
        <a
          href={links.soundcloud}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-medium rounded-lg bg-[#18181D] border border-white/10 text-zinc-200 hover:text-[#FF5500] hover:border-[#FF5500]/40 hover:bg-[#FF5500]/10 transition-colors"
        >
          <!-- SoundCloud SVG -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M11.56 8.87V17h1.16V8.87h-1.16zm-2.08 1.15v6.98h1.16v-6.98H9.48zm-2.08 1.76V17h1.16v-5.22H7.4zm-2.08 1.48V17h1.16v-3.74H5.32zm-2.08 1.18V17H4.4v-2.58H3.24zm-1.88.94V17h1.16v-1.64H1.36zM0 16.32V17h.48v-.68H0zm18.3 1.05c2.04 0 3.7-1.66 3.7-3.7 0-1.92-1.47-3.5-3.35-3.68-.38-2.6-2.62-4.62-5.35-4.62-.73 0-1.42.15-2.05.41v7.59h6.7c.36 0 .35.35.35.35 0 .19-.16.35-.35.35h-6.7V17h7.05c.01 0 .01.37 0 .37z"/>
          </svg>
          SoundCloud
        </a>
      )}

      {links.youtube && (
        <a
          href={links.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-medium rounded-lg bg-[#18181D] border border-white/10 text-zinc-200 hover:text-[#FF0000] hover:border-[#FF0000]/40 hover:bg-[#FF0000]/10 transition-colors"
        >
          <!-- YouTube SVG -->
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          YouTube
        </a>
      )}
    </div>
  </div>

  <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-3xl">
    {description}
  </p>
</article>
