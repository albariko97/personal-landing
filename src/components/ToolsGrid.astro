---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { siteConfig } from '../config/site';
import SectionHeader from './SectionHeader.astro';
import ToolCard from './ToolCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const tools = (await getCollection('tools', (entry) => entry.data.lang === lang)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<section id="tools" class="py-20 md:py-28 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index={t('tools.index')}
      title={t('tools.title')}
      description={t('tools.desc')}
    />

    <!-- Future Open Source Roadmap Card -->
    <div class="mb-8 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-[#131823] to-[#0d121c] border border-blue-500/20 hover:border-blue-500/35 transition-all relative overflow-hidden">
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-mono font-medium rounded-full bg-blue-500/15 text-blue-400 border border-blue-500/30">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
              {t('tools.roadmapBadge')}
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-100">
            {t('tools.roadmapTitle')}
          </h3>

          <p class="mt-3 text-sm sm:text-base text-zinc-300 leading-relaxed">
            {t('tools.roadmapDesc')}
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            {['Swift', 'watchOS', 'Apple Watch Ultra', 'Bühlmann ZHL-16C', 'Terraform', 'MCP'].map((tag) => (
              <span class="font-mono text-[11px] text-blue-300/80 bg-blue-500/10 border border-blue-500/20 px-2.5 py-0.5 rounded">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="shrink-0 flex items-center">
          <a
            href={siteConfig.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-mono font-medium rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-white/10 hover:border-white/20 transition-all shadow-md group"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>{t('tools.roadmapFollow')}</span>
            <span class="group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>

    {tools.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {tools.map((tool) => (
          <ToolCard tool={tool} lang={lang} />
        ))}
      </div>
    )}
  </div>
</section>
