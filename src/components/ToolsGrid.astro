---
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import ToolCard from './ToolCard.astro';

const tools = (await getCollection('tools')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<section id="tools" class="py-20 md:py-28 border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index="02 // TOOLS & OPEN SOURCE"
      title="Developer Tooling & Platform Utilities"
      description="Command-line interfaces, Model Context Protocol servers, and cloud engineering utilities built for speed."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {tools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </div>
</section>
